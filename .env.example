# Образец переменных окружения. Реальные значения в git не попадают.
#
# ГДЕ СОЗДАВАТЬ ФАЙЛ:
#   на сервере  — /var/www/clc-ufa/.env      ← его копирует и читает деплой
#   локально    — .env.local                 ← для разработки
#
# Имя на сервере именно .env: скрипт деплоя копирует его в standalone-сборку
# (см. .github/workflows/deploy.yml). Файл не перезаписывается при деплое,
# создаётся один раз руками.
#
# Значения не должны содержать пробелов: деплой прокидывает их в окружение
# через `export $(grep -v '^#' .env | xargs)`, и значение с пробелом сломает
# разбор. Если пароль с пробелом — возьмите его в кавычки.
#
# НИКОГДА не добавляйте к этим именам префикс NEXT_PUBLIC_ — переменные с ним
# попадают в браузерный бандл и станут видны всем.

# ── Почта для заявок и заказов ──────────────────────────────────────────────
# app/api/send-email/route.ts, app/api/order/route.ts
# Без них сайт работает, но письма молча не уходят — проверяйте после переезда.

SMTP_HOST=smtp.mail.ru
# 465 — SSL (по умолчанию), 587 — STARTTLS
SMTP_PORT=465
# Для mail.ru и Яндекса нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль от аккаунта
SMTP_USER=zakaz@example.ru
SMTP_PASS=
# Куда доставлять письма. Пусто — берётся business.email из data/contacts.ts
SMTP_TO=zakaz@example.ru

# ── Доставка ────────────────────────────────────────────────────────────────
# Пока не используются: интеграции не написаны (этапы 4–5 в docs/shop-own-plan.md).
# Имена уточним по документации служб, когда будем подключать, — сейчас это
# заготовка, чтобы ключи не пришлось искать по переписке.
# Обращения к API идут только с сервера: CSP запрещает такие запросы из браузера.

# СДЭК: начинать на тестовом контуре, потом боевые значения
CDEK_ACCOUNT=
CDEK_SECRET=
# true — тестовый контур, false — боевой
CDEK_TEST=true

# Ozon
OZON_CLIENT_ID=
OZON_API_KEY=

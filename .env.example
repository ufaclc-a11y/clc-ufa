# Скопируйте этот файл в .env.local и заполните значениями.
# .env.local в git не попадает (см. .gitignore).
#
# Без этих переменных сайт соберётся и запустится, но форма заказа будет
# молча не отправлять письма — проверьте их в первую очередь после переезда.

# ── Почта для заявок с сайта ────────────────────────────────────────────────
# Используется в app/api/send-email/route.ts и app/api/order/route.ts

# SMTP-сервер почтового провайдера
SMTP_HOST=smtp.mail.ru

# 465 — SSL (по умолчанию), 587 — STARTTLS
SMTP_PORT=465

# Логин и пароль ящика, от имени которого уходят письма.
# Для mail.ru и Яндекса нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль от аккаунта.
SMTP_USER=zakaz@example.ru
SMTP_PASS=

# Куда доставлять заявки. Если не задано — берётся business.email из data/contacts.ts
SMTP_TO=zakaz@example.ru

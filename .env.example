# Создайте файл .env.local и заполните:

# Telegram Bot — для отправки заявок из формы
# 1. Создайте бота через @BotFather -> /newbot
# 2. Скопируйте токен
TG_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# 3. Напишите боту /start, затем перейдите:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Найдите "chat":{"id": ...} — это и есть CHAT_ID
TG_CHAT_ID=123456789

# Образец переменных окружения. Реальные значения в git не попадают.
#
# ГДЕ СОЗДАВАТЬ ФАЙЛ:
#   на сервере  — /var/www/clc-ufa/.env      ← его копирует и читает деплой
#   локально    — .env.local                 ← для разработки
#
# Имя на сервере именно .env: скрипт деплоя копирует его в standalone-сборку
# (см. .github/workflows/deploy.yml). Файл не перезаписывается при деплое,
# создаётся один раз руками.
#
# Значения не должны содержать пробелов: деплой прокидывает их в окружение
# через `export $(grep -v '^#' .env | xargs)`, и значение с пробелом сломает
# разбор. Если пароль с пробелом — возьмите его в кавычки.
#
# НИКОГДА не добавляйте к этим именам префикс NEXT_PUBLIC_ — переменные с ним
# попадают в браузерный бандл и станут видны всем.

# ── Почта для заявок и заказов ──────────────────────────────────────────────
# app/api/send-email/route.ts, app/api/order/route.ts
# Без них сайт работает, но письма молча не уходят — проверяйте после переезда.

SMTP_HOST=smtp.mail.ru
# 465 — SSL (по умолчанию), 587 — STARTTLS
SMTP_PORT=465
# Для mail.ru и Яндекса нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль от аккаунта
SMTP_USER=zakaz@example.ru
SMTP_PASS=
# Куда доставлять письма. Пусто — берётся business.email из data/contacts.ts
SMTP_TO=zakaz@example.ru

# ── Доставка СДЭК ───────────────────────────────────────────────────────────
# lib/delivery/cdek.ts, роуты /api/delivery/*. Запросы идут только с сервера:
# CSP запрещает обращения к сторонним хостам из браузера, а ключи нельзя
# отдавать клиенту.
#
# Пока переменные пусты, магазин работает без расчёта: покупатель видит
# «стоимость доставки сообщит менеджер», оформление заказа не ломается.
#
# ВАЖНО: доступы к API выдаёт СДЭК по заявке (integrator@cdek.ru) — реквизиты
# от личного кабинета не подходят. Для тестового контура выдаются отдельные.

CDEK_ACCOUNT=
CDEK_SECRET=
# true — тестовый контур api.edu.cdek.ru, false — боевой api.cdek.ru
CDEK_TEST=true
# Город отправления для расчёта
CDEK_FROM_CITY=Уфа

# ── Доставка Почтой России ──────────────────────────────────────────────────
# Токен приложения и ключ пользователя из Настройки → API в кабинете
# https://otpravka.pochta.ru/settings#/api-settings
# Пока значения пусты, заказ оформляется без автоматического расчёта.
POCHTA_ACCESS_TOKEN=
# base64(login:password), без префикса "Basic "
POCHTA_USER_AUTH=
# Индекс отделения отправки. Если пусто, API берёт точку отправки из профиля.
POCHTA_FROM_INDEX=

# ── Wildberries: выгрузка габаритов ─────────────────────────────────────────
# Нужен ТОЛЬКО локально, для npm run gen:wb-dimensions. Сайту в работе не нужен,
# на сервер класть незачем.
#
# Токен с доступом к «Контенту» из кабинета продавца. Без него выгрузка идёт по
# публичным карточкам, а они отдают габариты не для всех категорий — часть
# товаров окажется без данных, и доставка по ним не посчитается.
WB_API_TOKEN=

# ── Доставка Ozon ───────────────────────────────────────────────────────────
# Интеграция не написана: сначала нужно подтвердить, что доставка Ozon
# доступна внешнему магазину по вашему договору (этап 5).
OZON_CLIENT_ID=
OZON_API_KEY=

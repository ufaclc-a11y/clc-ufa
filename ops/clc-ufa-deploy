#!/usr/bin/env bash
set -euo pipefail

readonly APP_DIR=/var/www/clc-ufa
readonly APP_USER=clcufa
readonly APP_GROUP=clcufa

run_as_app() {
  runuser -u "$APP_USER" -- env \
    HOME=/var/lib/clc-ufa \
    NODE_ENV=production \
    PUPPETEER_SKIP_DOWNLOAD=true \
    "$@"
}

cd "$APP_DIR"
run_as_app git fetch --all --prune
run_as_app git reset --hard origin/main
run_as_app git clean -fd
run_as_app npm ci --include=dev
run_as_app npm run build
run_as_app npm prune --omit=dev

mkdir -p "$APP_DIR/.next/cache"
chown -R "$APP_USER:$APP_GROUP" "$APP_DIR"
chmod -R go-w,o-rwx "$APP_DIR"

systemctl restart clc-ufa.service
for _ in $(seq 1 15); do
  if curl --fail --silent --show-error --output /dev/null http://127.0.0.1:3000/; then
    echo "Deploy OK"
    exit 0
  fi
  sleep 2
done

journalctl -u clc-ufa.service -n 50 --no-pager
exit 1
